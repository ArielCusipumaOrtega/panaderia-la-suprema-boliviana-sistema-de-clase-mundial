# ==============================================================================
# Panadería & Pastelería "La Suprema Boliviana" - Environment Configuration Example
# ==============================================================================

# Application Port
PORT=3000

# Environment Mode (development | production | test)
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=nombre_de_tu_bd

# JWT Secret Key for Authentication Tokens
JWT_SECRET=tu_clave_secreta_super_segura_aqui

# SIAT / SIN Bolivia Electronic Invoicing Configuration
SIAT_NIT_EMISOR=3049182019
SIAT_RAZON_SOCIAL="PANADERIA & PASTELERIA ARTESANAL BOLIVIA S.R.L."

# Frontend Client Configuration & CORS Origins (Comma-separated URLs for Vue.js / Vite / Nuxt)
# Example: http://localhost:5173,http://localhost:8080,https://mi-panaderia-bolivia.web.app
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://localhost:3000
