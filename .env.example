# JWT Secret Key for Authentication Tokens
JWT_SECRET=tu_clave_secreta_super_segura_aqui

# SIAT / SIN Bolivia Electronic Invoicing Configuration
SIAT_NIT_EMISOR=123456789
SIAT_RAZON_SOCIAL="MI EMPRESA S.R.L."
